{
  "name": "rtc-compatibility-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Black-box E2E compatibility suite for EkbatanRoom WebRTC SFU and Signaling Coordinator",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p harness-app/tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:gates": "playwright test",
    "harness:dev": "vite --config harness-app/vite.config.ts",
    "harness:build": "vite build --config harness-app/vite.config.ts"
  },
  "dependencies": {
    "livekit-client": "2.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.1",
    "jose": "5.9.6",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
